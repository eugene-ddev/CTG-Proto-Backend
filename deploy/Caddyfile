# Один домен:
#   /ctg/        — игра: клиент и API Nakama (/ctg/v2, /ctg/ws; префикс срезается)
#   всё прочее   — консоль Nakama (она умеет работать только из корня: /static, /v2/console, свой роутер)
# Сертификат Caddy получает сам. Папка игры — GAME_PATH в .env (по умолчанию /ctg).
{$DOMAIN} {
	encode zstd gzip

	redir {$GAME_PATH:/ctg} {$GAME_PATH:/ctg}/ 301

	handle_path {$GAME_PATH:/ctg}/* {
		@api path /v2/* /ws /healthcheck
		handle @api {
			reverse_proxy nakama:7350
		}

		handle {
			root * /srv
			# index.html не кешируется — новая версия клиента подхватывается сразу; файлы сборки — с хешем в имени
			header /index.html Cache-Control "no-cache"
			header / Cache-Control "no-cache"
			file_server
		}
	}

	handle {
		reverse_proxy nakama:7351
	}
}
