# Пример ../.env для боевого сервера. Настоящий файл создаёт deploy/setup.sh (секреты генерируются).
DOMAIN=example.com
# папка игры на домене; корень домена — консоль Nakama
GAME_PATH=/ctg
# true — у всех игроков работают debug-действия (кубы, предметы, лечение) и сброс игрока
CTG_DEBUG=false

POSTGRES_PASSWORD=
# ключ клиента: попадает в сборку клиента, секретом не является
SERVER_KEY=
HTTP_KEY=
SESSION_KEY=
REFRESH_KEY=
CONSOLE_USER=admin
CONSOLE_PASSWORD=
CONSOLE_SIGNING_KEY=
